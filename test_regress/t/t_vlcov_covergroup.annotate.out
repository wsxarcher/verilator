%000004       bins values[] = {[0 : 3]};
-000004  point: type=covergroup comment= hier=cg_cross_ignore_array.cp_data.values
            }
%000004     cp_cmd: coverpoint cmd {bins any = {[0 : 1]};}
-000004  point: type=covergroup comment= hier=cg_cross_ignore_array.cp_cmd.any
%000001     data_cmd: cross cp_data, cp_cmd {
-000001  point: type=covergroup comment= hier=cg_cross_ignore_array.data_cmd.values[1]_x_any
        //  cross: [values[1], any]
-000001  point: type=covergroup comment= hier=cg_cross_ignore_array.data_cmd.values[2]_x_any
        //  cross: [values[2], any]
-000001  point: type=covergroup comment= hier=cg_cross_ignore_array.data_cmd.values[3]_x_any
        //  cross: [values[3], any]
              ignore_bins empty = binsof(cp_data.empty);
              ignore_bins zero = binsof(cp_data.values) intersect {0};
