%000001       bins neg_one = {-1};
-000001  point: type=covergroup comment= hier=cg_cross_ignore_signed_wide.cp_data.neg_one
%000001       bins one = {1};
-000001  point: type=covergroup comment= hier=cg_cross_ignore_signed_wide.cp_data.one
            }
%000002     cp_cmd: coverpoint cmd {bins any = {[0 : 1]};}
-000002  point: type=covergroup comment= hier=cg_cross_ignore_signed_wide.cp_cmd.any
%000001     data_cmd: cross cp_data, cp_cmd {
-000001  point: type=covergroup comment= hier=cg_cross_ignore_signed_wide.data_cmd.one_x_any
        //  cross: [one, any]
              ignore_bins neg_one = binsof(cp_data) intersect {-1};
            }
          endgroup
        
          // Qualified binsof on a wildcard bin
          covergroup cg_cross_ignore_wildcard;
            cp_data: coverpoint wildcard_data {
%000001       wildcard bins low = {4'b0???};
-000001  point: type=covergroup comment= hier=cg_cross_ignore_wildcard.cp_data.low
%000001       wildcard bins high = {4'b1???};
-000001  point: type=covergroup comment= hier=cg_cross_ignore_wildcard.cp_data.high
            }
%000002     cp_cmd: coverpoint cmd {bins any = {[0 : 1]};}
-000002  point: type=covergroup comment= hier=cg_cross_ignore_wildcard.cp_cmd.any
%000001     data_cmd: cross cp_data, cp_cmd {
-000001  point: type=covergroup comment= hier=cg_cross_ignore_wildcard.data_cmd.high_x_any
        //  cross: [high, any]
              ignore_bins low = binsof(cp_data.low);
