%000001       wildcard bins low = {4'b00??};
-000001  point: type=covergroup comment= hier=cg_cross_ignore_wildcard_intersect.cp_data.low
%000001       wildcard bins middle = {4'b01??};
-000001  point: type=covergroup comment= hier=cg_cross_ignore_wildcard_intersect.cp_data.middle
%000001       wildcard bins high = {4'b1???};
-000001  point: type=covergroup comment= hier=cg_cross_ignore_wildcard_intersect.cp_data.high
            }
%000003     cp_cmd: coverpoint cmd {bins any = {[0 : 1]};}
-000003  point: type=covergroup comment= hier=cg_cross_ignore_wildcard_intersect.cp_cmd.any
%000001     data_cmd: cross cp_data, cp_cmd {
-000001  point: type=covergroup comment= hier=cg_cross_ignore_wildcard_intersect.data_cmd.high_x_any
        //  cross: [high, any]
              ignore_bins low = binsof(cp_data) intersect {4'h1};
              ignore_bins middle = binsof(cp_data.middle) intersect {4'h5};
            }
          endgroup
        
          // Wildcard array bins expand into one concrete bin per matching value
          covergroup cg_cross_ignore_wildcard_array;
            cp_data: coverpoint wildcard_data {
%000004       wildcard bins patterns[] = {4'b11??};
-000004  point: type=covergroup comment= hier=cg_cross_ignore_wildcard_array.cp_data.patterns
            }
%000004     cp_cmd: coverpoint cmd {bins any = {[0 : 1]};}
-000004  point: type=covergroup comment= hier=cg_cross_ignore_wildcard_array.cp_cmd.any
%000001     data_cmd: cross cp_data, cp_cmd {
-000001  point: type=covergroup comment= hier=cg_cross_ignore_wildcard_array.data_cmd.patterns[1]_x_any
        //  cross: [patterns[1], any]
-000001  point: type=covergroup comment= hier=cg_cross_ignore_wildcard_array.data_cmd.patterns[2]_x_any
        //  cross: [patterns[2], any]
-000001  point: type=covergroup comment= hier=cg_cross_ignore_wildcard_array.data_cmd.patterns[3]_x_any
        //  cross: [patterns[3], any]
              ignore_bins twelve = binsof(cp_data.patterns) intersect {4'hc};
