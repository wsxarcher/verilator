%000001     cp_addr: coverpoint addr {bins addr0 = {0}; bins addr1 = {1};}
-000001  point: type=covergroup comment= hier=cg5.cp_addr.addr0
-000001  point: type=covergroup comment= hier=cg5.cp_addr.addr1
%000001     cp_cmd: coverpoint cmd {bins read = {0}; bins write = {1};}
-000001  point: type=covergroup comment= hier=cg5.cp_cmd.read
-000001  point: type=covergroup comment= hier=cg5.cp_cmd.write
%000001     addr_cmd_opt: cross cp_addr, cp_cmd{option.weight = 2;}
-000001  point: type=covergroup comment= hier=cg5.addr_cmd_opt.addr0_x_read
