%000001       bins zero = {0};
-000001  point: type=covergroup comment= hier=cg_cross_ignore_signed.cp_data.zero
%000001       bins one = {1};
-000001  point: type=covergroup comment= hier=cg_cross_ignore_signed.cp_data.one
%000002       bins two = {2};
-000002  point: type=covergroup comment= hier=cg_cross_ignore_signed.cp_data.two
%000002       bins three = {3};
-000002  point: type=covergroup comment= hier=cg_cross_ignore_signed.cp_data.three
            }
%000003     cp_cmd: coverpoint cmd {bins read = {0}; bins write = {1};}
-000003  point: type=covergroup comment= hier=cg_cross_ignore_signed.cp_cmd.read
-000003  point: type=covergroup comment= hier=cg_cross_ignore_signed.cp_cmd.write
%000001     data_cmd: cross cp_data, cp_cmd {
-000001  point: type=covergroup comment= hier=cg_cross_ignore_signed.data_cmd.three_x_read
        //  cross: [three, read]
-000001  point: type=covergroup comment= hier=cg_cross_ignore_signed.data_cmd.three_x_write
        //  cross: [three, write]
-000001  point: type=covergroup comment= hier=cg_cross_ignore_signed.data_cmd.two_x_read
        //  cross: [two, read]
-000001  point: type=covergroup comment= hier=cg_cross_ignore_signed.data_cmd.two_x_write
        //  cross: [two, write]
              ignore_bins low = binsof(cp_data) intersect {[0 : 1]};
            }
          endgroup
        
          // Cross ignore_bins with negative singleton, closed-range, and open-range selectors
          covergroup cg_cross_ignore_signed_negative;
            cp_data: coverpoint signed_data {
%000002       bins neg_four = {-4};
-000002  point: type=covergroup comment= hier=cg_cross_ignore_signed_negative.cp_data.neg_four
%000002       bins neg_three = {-3};
-000002  point: type=covergroup comment= hier=cg_cross_ignore_signed_negative.cp_data.neg_three
%000002       bins neg_two = {-2};
-000002  point: type=covergroup comment= hier=cg_cross_ignore_signed_negative.cp_data.neg_two
%000002       bins neg_one = {-1};
-000002  point: type=covergroup comment= hier=cg_cross_ignore_signed_negative.cp_data.neg_one
%000002       bins zero = {0};
-000002  point: type=covergroup comment= hier=cg_cross_ignore_signed_negative.cp_data.zero
%000002       bins one = {1};
-000002  point: type=covergroup comment= hier=cg_cross_ignore_signed_negative.cp_data.one
            }
%000006     cp_cmd: coverpoint cmd {bins read = {0}; bins write = {1};}
-000006  point: type=covergroup comment= hier=cg_cross_ignore_signed_negative.cp_cmd.read
-000006  point: type=covergroup comment= hier=cg_cross_ignore_signed_negative.cp_cmd.write
%000001     data_cmd: cross cp_data, cp_cmd {
-000001  point: type=covergroup comment= hier=cg_cross_ignore_signed_negative.data_cmd.one_x_read
        //  cross: [one, read]
-000001  point: type=covergroup comment= hier=cg_cross_ignore_signed_negative.data_cmd.one_x_write
        //  cross: [one, write]
-000001  point: type=covergroup comment= hier=cg_cross_ignore_signed_negative.data_cmd.zero_x_read
        //  cross: [zero, read]
-000001  point: type=covergroup comment= hier=cg_cross_ignore_signed_negative.data_cmd.zero_x_write
        //  cross: [zero, write]
              ignore_bins min_value = binsof(cp_data) intersect {[$ : -4]};
              ignore_bins negative_range = binsof(cp_data) intersect {[-3 : -2]};
              ignore_bins negative_singleton = binsof(cp_data) intersect {-1};
            }
          endgroup
        
          // Cross ignore_bins widens a negative signed selector to the coverpoint width
