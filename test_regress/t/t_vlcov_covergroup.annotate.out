          // Cross ignore_bins using bare/qualified binsof, &&, ||, !, and parentheses
          covergroup cg_cross_ignore_logic;
%000001     cp_addr: coverpoint addr {bins addr0 = {0}; bins addr1 = {1};}
-000001  point: type=covergroup comment= hier=cg_cross_ignore_logic.cp_addr.addr0
-000001  point: type=covergroup comment= hier=cg_cross_ignore_logic.cp_addr.addr1
%000001     cp_cmd: coverpoint cmd {bins read = {0}; bins write = {1};}
-000001  point: type=covergroup comment= hier=cg_cross_ignore_logic.cp_cmd.read
-000001  point: type=covergroup comment= hier=cg_cross_ignore_logic.cp_cmd.write
%000001     addr_cmd: cross cp_addr, cp_cmd {
