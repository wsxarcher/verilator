            cp_addr: coverpoint addr {
%000001       ignore_bins ign = {3};  // addr=3 excluded from cross
-000001  point: type=covergroup comment= hier=cg_ignore.cp_addr.ign
%000002       bins a0 = {0};
-000002  point: type=covergroup comment= hier=cg_ignore.cp_addr.a0
%000002       bins a1 = {1};
-000002  point: type=covergroup comment= hier=cg_ignore.cp_addr.a1
            }
%000003     cp_cmd: coverpoint cmd {bins read = {0}; bins write = {1};}
-000003  point: type=covergroup comment= hier=cg_ignore.cp_cmd.read
-000002  point: type=covergroup comment= hier=cg_ignore.cp_cmd.write
%000001     cross_ab: cross cp_addr, cp_cmd;
-000001  point: type=covergroup comment= hier=cg_ignore.cross_ab.a0_x_read
        //  cross: [a0, read]
-000001  point: type=covergroup comment= hier=cg_ignore.cross_ab.a0_x_write
        //  cross: [a0, write]
-000001  point: type=covergroup comment= hier=cg_ignore.cross_ab.a1_x_read
        //  cross: [a1, read]
-000001  point: type=covergroup comment= hier=cg_ignore.cross_ab.a1_x_write
        //  cross: [a1, write]
          endgroup
        
          // Cross ignore_bins using binsof, intersect value/range lists, &&, and negation
          covergroup cg_cross_ignore;
            cp_addr: coverpoint addr {
%000001       bins addr0 = {0};
-000001  point: type=covergroup comment= hier=cg_cross_ignore.cp_addr.addr0
%000002       bins addr1 = {1};
-000002  point: type=covergroup comment= hier=cg_cross_ignore.cp_addr.addr1
%000001       bins addr2 = {2};
-000001  point: type=covergroup comment= hier=cg_cross_ignore.cp_addr.addr2
%000001       bins addr3 = {3};
-000001  point: type=covergroup comment= hier=cg_cross_ignore.cp_addr.addr3
            }
%000004     cp_cmd: coverpoint cmd {bins read = {0}; bins write = {1};}
-000004  point: type=covergroup comment= hier=cg_cross_ignore.cp_cmd.read
-000001  point: type=covergroup comment= hier=cg_cross_ignore.cp_cmd.write
%000001     addr_cmd: cross cp_addr, cp_cmd {
-000001  point: type=covergroup comment= hier=cg_cross_ignore.addr_cmd.addr1_x_read
        //  cross: [addr1, read]
-000001  point: type=covergroup comment= hier=cg_cross_ignore.addr_cmd.addr1_x_write
        //  cross: [addr1, write]
-000001  point: type=covergroup comment= hier=cg_cross_ignore.addr_cmd.addr2_x_read
        //  cross: [addr2, read]
-000001  point: type=covergroup comment= hier=cg_cross_ignore.addr_cmd.addr3_x_read
        //  cross: [addr3, read]
              ignore_bins no_values = !binsof(cp_addr) intersect {[$ : $]};
              ignore_bins outside_domain = binsof(cp_addr) intersect {-1, 4};
              ignore_bins reversed_range = binsof(cp_addr) intersect {[3 : 1]};
              ignore_bins addr0 = !binsof(cp_addr) intersect {[1 : 3]};
              ignore_bins high_write
