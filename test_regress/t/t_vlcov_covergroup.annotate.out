        //  cross: [hi_range, write]
-000001  point: type=covergroup comment= hier=cg_range.addr_cmd_range.lo_range_x_read
        //  cross: [lo_range, read]
-000001  point: type=covergroup comment= hier=cg_range.addr_cmd_range.lo_range_x_write
        //  cross: [lo_range, write]
